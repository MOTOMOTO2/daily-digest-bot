# Copy to .env and fill in. .env is gitignored.
# Any ${VAR} in config.toml is substituted from here or the real environment.

# Slack incoming webhook for the digest channel.
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxxxxxx

# Optional second webhook, used only to report that the digest failed to send.
ALERT_WEBHOOK_URL=

# Optional: tokens for API sources, referenced as ${GITHUB_TOKEN} in config.
GITHUB_TOKEN=
